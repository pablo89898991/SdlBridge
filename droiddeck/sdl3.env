# SDL3 built into SDL3DroidDeck (patch-droiddeck.sh step 30, only with SDL3_EMBED_BRIDGE=1): its release and the
# SHA-256 of its source archive (https://github.com/libsdl-org/SDL/releases/download/release-<version>/SDL3-<version>.tar.gz).
# Kept current by the "SDL update" workflow (.github/workflows/sdl-update.yml): it moves both lines to SDL's newest
# stable SDL3 release once SDL3DroidDeck's patch and the bridge app have been tested with it. By hand: change both
# lines (sha256sum of the new archive), or run that workflow with a version. The bridge app builds with this SDL too.
SDL_VERSION=3.4.20
SDL_SHA256=f3bb06f55bed9557227a700af2ea62e49497ebdf58037732a731a5fb3ef8581f
