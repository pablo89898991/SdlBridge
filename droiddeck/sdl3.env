# SDL3 built into SDL3DroidDeck (patch-droiddeck.sh step 30, only with SDL3_EMBED_BRIDGE=1): its release and the
# SHA-256 of its source archive (https://github.com/libsdl-org/SDL/releases/download/release-<version>/SDL3-<version>.tar.gz).
# To move to a newer SDL3: change both lines (sha256sum of the new archive).
SDL_VERSION=3.4.18
SDL_SHA256=9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3
